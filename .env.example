# Live AI (choose one). Without any, the app runs in demo mode + manual picker.
# 1) Vercel AI Gateway: run `vercel env pull .env.local` (OIDC) or set:
AI_GATEWAY_API_KEY=
# 2) Google Gemini directly:
GOOGLE_GENERATIVE_AI_API_KEY=
# Signs evidence receipts (any long random string)
RECEIPT_SECRET=
# Optional NYC Open Data app token (raises rate limits)
SOCRATA_APP_TOKEN=
